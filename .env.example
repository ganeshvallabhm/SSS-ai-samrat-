# ==============================================================================
# SSS Civic Tech — Environment Variables
# ==============================================================================

# PostgreSQL superuser password
# Format: High-entropy string (alphanumeric/url-safe, minimum 16 chars)
# Generate: openssl rand -base64 24   OR   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=replace_with_secure_postgres_password

# JWT Authentication Secret
# Format: High-entropy string, at least 32 characters (256 bits)
# Generate: openssl rand -hex 32   OR   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_random_jwt_secret_at_least_32_chars

# Voucher Code Encryption Key (for AES-256-GCM)
# Format: Exactly 32 bytes represented as 64 hexadecimal characters
# Generate: openssl rand -hex 32   OR   python -c "import secrets; print(secrets.token_hex(32))"
VOUCHER_ENCRYPTION_KEY=replace_with_64_char_hex_encryption_key

# Database Connection URLs (derived using ${POSTGRES_PASSWORD} in docker-compose.yml)
# Async URL: postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@db:5432/civic_spark
# Sync URL: postgresql+psycopg2://postgres:${POSTGRES_PASSWORD}@db:5432/civic_spark
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_secure_postgres_password@db:5432/civic_spark
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:replace_with_secure_postgres_password@db:5432/civic_spark

# Upload storage directory inside container
UPLOAD_DIR=/app/uploads

# Environment: development | production | test
ENVIRONMENT=development
