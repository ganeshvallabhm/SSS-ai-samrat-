# SSS Civic Tech Frontend Environment Configuration Example
# Copy this file to .env.local to enable backend mode in Vite development:
#   copy .env.local.example .env.local
# (Vite automatically loads .env.local and merges with root .env without committing your local overrides)

# Set to "true" to switch frontend from offline localStorage demo mode to live FastAPI backend
VITE_USE_BACKEND_API=true

# Base URL for the FastAPI v1 endpoints (matches backend/app/main.py prefix)
VITE_API_BASE_URL=http://localhost:8888/api/v1

# Request timeout in milliseconds (defaults to 15000)
VITE_API_TIMEOUT_MS=15000
